---
import brennlabsIcon from "../assets/brennlabs_icon.svg?raw";
import lazadaIcon from "../assets/icons/lazada.svg";
import shopeeIcon from "../assets/icons/shopee.svg";
import tiktokIcon from "../assets/icons/tiktok.svg";
---

<section
    class="bg-gray-50/80 px-4 md:px-8"
    aria-labelledby="jumbotron-heading-6"
>
    <div class="home-hero max-w-6xl mx-auto pt-6">
        <div class="bg-icon">
            <Fragment set:html={brennlabsIcon} />
        </div>

        <div class="p-6 w-full md:p-8 my-[60px]">
            <h2
                id="jumbotron-heading-6"
                class="text-3xl mb-3 font-bold text-slate-900 md:text-4xl"
            >
                Manufacturing Ideas Into Reality
            </h2>
            <p
                class="text-base text-slate-900 leading-relaxed w-full md:max-w-170"
            >
                We design and manufacture custom 3D printed products,
                prototypes, branded merchandise, lamps, toys, and functional
                parts.
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mt-6">
            <div
                class="w-full p-8 bg-white/5 border border-white/10 backdrop-blur-xl shadow-2xl transition-all duration-500 hover:border-white/20 hover:bg-white/10"
            >
                <h2 class="text-slate-900 text-2xl font-semibold">
                    Let's Build Something Great Together
                </h2>
                <div class="mt-4">
                    <p class="text-base text-slate-600 leading-relaxed">
                        Whether it's a custom product, prototype, promotional
                        item, lamp, toy, or manufacturing project, we're ready
                        to help.
                    </p>
                </div>
                <a
                    href="#"
                    class="py-2 px-3.5 text-sm rounded-md font-semibold cursor-pointer text-white border border-cyan-500 bg-cyan-500 mt-6 inline-block hover:bg-cyan-700 hover:border-cyan-700 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500"
                >
                    Request a Quote
                </a>
            </div>

            <div class="p-6 w-full md:p-8 py-20">
                <h2 class="text-slate-900 text-2xl font-semibold">
                    We are live on our e-commerce platforms!
                </h2>
                <div class="mt-4">
                    <p class="text-base text-slate-900 leading-relaxed">
                        We offer customizable 3D printed products, imported toys
                        and consumer electronics delivered to your doorsteps.
                    </p>
                </div>
                <div class="flex flex-row gap-10 align-center pt-10 ps-0">
                    <a
                        href="https://shopee.ph/shop/1857845118"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img
                            src={shopeeIcon.src}
                            class="w-[46px] h-auto -translate-y-1"
                        />
                    </a>
                    <a
                        href="https://s.lazada.com.ph/s.ZgSxSr"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img src={lazadaIcon.src} class="w-[46px] h-auto" />
                    </a>
                    <a
                        href="https://www.tiktok.com/@brennlabs"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img src={tiktokIcon.src} class="w-[48px] h-auto" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .home-hero {
        position: relative;
    }

    .bg-icon {
        position: absolute;
        bottom: 0;
        left: calc(100% - 300px);
        z-index: -1;
    }

    .bg-icon > :global(svg) {
        width: 300px;
        height: auto;
    }
</style>
