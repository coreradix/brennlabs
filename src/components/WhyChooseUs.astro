---
import whyChooseUs from "../assets/images/whychooseus.webp";
---

<section id="_features_split_panel_v6_001" class="py-20 sm:py-24 bg-gray-50/80">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-8">
        <!-- Full-width Heading Section -->
        <div class="text-center mb-16">
            <span
                data-motion="badge"
                class="inline-block px-3 py-1 text-sm font-medium text-cyan-600 bg-cyan-100 rounded-full mb-4"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                >Our Capabilities</span
            >
            <h2
                data-motion="heading"
                class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
            >
                <span data-animate="heading" style="opacity: 1;"
                    ><span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >Why</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >Choose</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >Us</span
                    ></span
                >
            </h2>
            <p
                data-motion="text"
                class="text-lg text-slate-600 max-w-2xl mx-auto"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
            >
                <span data-animate="text" style="opacity: 1;"
                    ><span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >End-to-end</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >design</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >and</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >manufacturing</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >expertise</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >for</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >your</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >custom</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >projects.</span
                    ></span
                >
            </p>
        </div>

        <!-- Grid with Image Panel and Cards -->
        <div class="grid lg:grid-cols-12 gap-10">
            <!-- Left Panel with Image -->
            <div
                class="lg:col-span-5"
                data-motion="panel"
                style="opacity: 1; transform: translateY(0px);"
            >
                <div class="bg-white rounded-3xl p-8 h-full flex flex-col">
                    <h3
                        class="text-slate-900 text-xl sm:text-2xl font-bold mb-4"
                    >
                        <span data-animate="heading" style="opacity: 1;"
                            ><span
                                class="motion-word"
                                style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                                >What</span
                            >
                            <span
                                class="motion-word"
                                style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                                >Makes</span
                            >
                            <span
                                class="motion-word"
                                style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                                >Us</span
                            >
                            <span
                                class="motion-word"
                                style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                                >Different</span
                            ></span
                        >
                    </h3>
                    <p
                        data-animate="text"
                        class="text-slate-600 text-lg mb-8"
                        style="opacity: 1;"
                    >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >From</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >custom</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >design</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >to</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >finished</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >product,</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >we</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >handle</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >every</span
                        >
                        <span
                            class="motion-word"
                            style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                            >step.</span
                        >
                    </p>
                    <div class="rounded-2xl overflow-hidden mt-auto mb-6">
                        <img
                            data-motion="image"
                            src={whyChooseUs.src}
                            alt="Our Manufacturing Facility"
                            class="w-full h-64 object-cover"
                            style="opacity: 1; transform: scale(1); filter: blur(0px);"
                        />
                    </div>
                    <a
                        data-motion="button"
                        href="#"
                        class="inline-flex items-center gap-2 text-cyan-600 font-semibold hover:gap-3 transition-all duration-300 w-fit"
                        style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                    >
                        Get in Touch
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Right Grid -->
            <div class="lg:col-span-7 grid sm:grid-cols-2 gap-7">
                <div
                    data-motion="card"
                    class="p-8 bg-cyan-500 rounded-3xl"
                    style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                >
                    <div
                        data-motion="icon"
                        class="w-12 h-12 bg-cyan-100 rounded-3xl flex items-center justify-center mb-5"
                        style="opacity: 1; transform: scale(1); filter: blur(0px);"
                    >
                        <svg
                            class="w-6 h-6 text-cyan-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-white text-lg font-semibold mb-2">
                        Custom Design & Manufacturing
                    </h3>
                    <p class="text-white text-sm">
                        From concept to creation - we design and 3D print custom
                        products tailored to your exact specifications.
                    </p>
                </div>

                <div
                    data-motion="card"
                    class="p-8 bg-white rounded-3xl"
                    style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                >
                    <div
                        data-motion="icon"
                        class="w-12 h-12 bg-cyan-100 rounded-3xl flex items-center justify-center mb-5"
                        style="opacity: 1; transform: scale(1); filter: blur(0px);"
                    >
                        <svg
                            class="w-6 h-6 text-cyan-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-slate-900 text-lg font-semibold mb-2">
                        Personalized Products
                    </h3>
                    <p class="text-slate-600 text-sm">
                        Custom names, designs, and specifications on every item
                        - lamps, keychains, organizers, fidgets, and more.
                    </p>
                </div>

                <div
                    data-motion="card"
                    class="p-8 bg-white rounded-3xl"
                    style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                >
                    <div
                        data-motion="icon"
                        class="w-12 h-12 bg-cyan-100 rounded-3xl flex items-center justify-center mb-5"
                        style="opacity: 1; transform: scale(1); filter: blur(0px);"
                    >
                        <svg
                            class="w-6 h-6 text-cyan-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                        </svg>
                    </div>
                    <h3 class="text-slate-900 text-lg font-semibold mb-2">
                        Rapid Prototyping
                    </h3>
                    <p class="text-slate-600 text-sm">
                        Fast turnaround for prototypes and functional parts -
                        perfect for product development and testing.
                    </p>
                </div>

                <div
                    data-motion="card"
                    class="p-8 bg-cyan-500 rounded-3xl"
                    style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                >
                    <div
                        data-motion="icon"
                        class="w-12 h-12 bg-white/20 rounded-3xl flex items-center justify-center mb-5"
                        style="opacity: 1; transform: scale(1); filter: blur(0px);"
                    >
                        <svg
                            class="w-6 h-6 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-white text-lg font-semibold mb-2">
                        Branded Merchandise
                    </h3>
                    <p class="text-cyan-100 text-sm">
                        Custom corporate gifts, promotional items, and branded
                        merchandise for your business or events.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
