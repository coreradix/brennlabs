---
import productKeyboardFidget from "../assets/images/product_keyboardfidget.webp";
import productKeychainCharms from "../assets/images/product_keychaincharms.webp";
import productPenHolder from "../assets/images/product_penholder.webp";
import productTotoroLamp from "../assets/images/product_totorolamp.webp";
import hele from "../assets/images/hele.webp";
---

<section id="_portfolio_bento_grid_v5_001" class="py-20 sm:py-24 bg-gray-50/80">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-8">
        <div class="text-center mb-16">
            <span
                data-motion="badge"
                class="inline-block px-3 py-1 text-sm font-medium text-cyan-600 bg-cyan-100 rounded-full mb-4"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                >Portfolio</span
            >
            <h2
                data-motion="heading"
                class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
            >
                <span data-animate="heading" style="opacity: 1;"
                    ><span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >Featured</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >products</span
                    ></span
                >
            </h2>
            <p
                data-motion="text"
                class="text-lg text-slate-600"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
            >
                <span data-animate="text" style="opacity: 1;"
                    ><span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >Explore</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >our</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >diverse</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >range</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >of</span
                    >
                    <span
                        class="motion-word"
                        style="display: inline-block; opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >projects.</span
                    ></span
                >
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <a
                href="https://brennlabs.shop/hele"
                target="_blank"
                rel="noopener noreferrer"
                class="col-span-2 row-span-2 relative group overflow-hidden rounded-2xl"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                data-motion="card"
            >
                <img
                    data-motion="image"
                    src={hele.src}
                    alt="Project"
                    class="w-full h-full object-cover aspect-square"
                    style="opacity: 1; transform: scale(1); filter: blur(0px);"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-cyan-900/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                >
                    <div class="absolute bottom-6 left-6">
                        <span class="text-cyan-300 text-sm">Product Line</span>
                        <h3 class="text-xl font-bold text-white">Hele Lamps</h3>
                    </div>
                </div>
            </a>
            <a
                href="https://shopee.ph/Custom-Name-Keyboard-Fidget-Clicker-by-BRENNLABS-for-GIFT-SOUVENIR-BAG-ID-AND-TUMBLER-i.1857845118.51413847844?extraParams=%7B%22display_model_id%22%3A331197326576%2C%22model_selection_logic%22%3A2%7D"
                target="_blank"
                rel="noopener noreferrer"
                class="relative group overflow-hidden rounded-2xl"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                data-motion="card"
            >
                <img
                    data-motion="image"
                    src={productKeyboardFidget.src}
                    alt="Keyboard Fidget Product"
                    class="w-full h-full object-cover aspect-square"
                    style="opacity: 1; transform: scale(1); filter: blur(0px);"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-cyan-900/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                >
                    <div class="absolute bottom-4 left-4">
                        <span class="text-cyan-300 text-xs">Keychain</span>
                        <h3 class="text-sm font-bold text-white">
                            Keyboard Fidget
                        </h3>
                    </div>
                </div>
            </a>
            <a
                href="https://shopee.ph/Custom-Name-Keychain-Charms-by-BRENNLABS-for-BAG-ID-TUMBLER-KEY-CHARM-FOR-GIFT-AND-SOUVENIR-i.1857845118.54963854135?extraParams=%7B%22display_model_id%22%3A331197791128%2C%22model_selection_logic%22%3A3%7D"
                target="_blank"
                rel="noopener noreferrer"
                class="relative group overflow-hidden rounded-2xl"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                data-motion="card"
            >
                <img
                    data-motion="image"
                    src={productKeychainCharms.src}
                    alt="Keychain Charms Product"
                    class="w-full h-full object-cover aspect-square"
                    style="opacity: 1; transform: scale(1); filter: blur(0px);"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-cyan-900/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                >
                    <div class="absolute bottom-4 left-4">
                        <span class="text-cyan-300 text-xs">Keychain</span>
                        <h3 class="text-sm font-bold text-white">
                            Keychain Charms
                        </h3>
                    </div>
                </div>
            </a>
            <a
                href="https://shopee.ph/Custom-Name-Pen-Holder-Desk-Organizer-By-BRENNLABS-for-GIFT-SOUVENIR-OFFICE-DESK-i.1857845118.26295368231?extraParams=%7B%22display_model_id%22%3A416251663213%2C%22model_selection_logic%22%3A3%7D"
                target="_blank"
                rel="noopener noreferrer"
                class="relative group overflow-hidden rounded-2xl"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                data-motion="card"
            >
                <img
                    data-motion="image"
                    src={productPenHolder.src}
                    alt="Pen Holder Product"
                    class="w-full h-full object-cover aspect-square"
                    style="opacity: 1; transform: scale(1); filter: blur(0px);"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-cyan-900/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                >
                    <div class="absolute bottom-4 left-4">
                        <span class="text-cyan-300 text-xs">Organizer</span>
                        <h3 class="text-sm font-bold text-white">Pen Holder</h3>
                    </div>
                </div>
            </a>
            <a
                href="https://shopee.ph/Totoro-Lamp-Inspired-Ghibli-by-BRENNLABS-Cute-Anime-Soft-Glow-Lamp-i.1857845118.48015327781?extraParams=%7B%22display_model_id%22%3A366312104071%2C%22model_selection_logic%22%3A3%7D"
                target="_blank"
                rel="noopener noreferrer"
                class="relative group overflow-hidden rounded-2xl"
                style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                data-motion="card"
            >
                <img
                    data-motion="image"
                    src={productTotoroLamp.src}
                    alt="Totoro Lamp Product"
                    class="w-full h-full object-cover aspect-square"
                    style="opacity: 1; transform: scale(1); filter: blur(0px);"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-cyan-900/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                >
                    <div class="absolute bottom-4 left-4">
                        <span class="text-cyan-300 text-xs">Lamps</span>
                        <h3 class="text-sm font-bold text-white">
                            Totoro Lamp
                        </h3>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>
