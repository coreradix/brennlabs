---
import "../styles/global.css";
import brennlabsText from "../assets/brennlabs_text.svg?raw";
import brennlabsLogo from "../assets/brennlabs.svg?raw";
import pisoStlImage from "../assets/pisostl.webp";
import { Font } from "astro:assets";
---

<script>
    const toggleOpen = document.getElementById("toggleOpen");
    const toggleClose = document.getElementById("toggleClose");
    const menu = document.getElementById("collapseMenu");

    let lastFocusedElement: HTMLElement | null = null;

    function openMenu() {
        lastFocusedElement = document.activeElement as HTMLElement;
        menu?.classList.remove("hidden");
        toggleOpen?.setAttribute("aria-expanded", "true");

        // Move focus into menu
        menu?.focus();
    }

    function closeMenu() {
        menu?.classList.add("hidden");
        toggleOpen?.setAttribute("aria-expanded", "false");

        // Restore focus
        lastFocusedElement?.focus();
    }

    toggleOpen?.addEventListener("click", openMenu);
    toggleClose?.addEventListener("click", closeMenu);

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu?.classList.contains("hidden")) {
            closeMenu();
        }
    });

    // Mega menu logic
    const button = document.getElementById("mega-menu-button");
    const megaMenu = document.getElementById("mega-menu");

    const focusableSelectors =
        "a[href], button:not([disabled]), [tabindex='0']";

    const getFocusableElements = () =>
        megaMenu?.querySelectorAll(focusableSelectors);

    // 👉 helper for active state
    function setActiveState(isActive: boolean) {
        button?.classList.toggle("text-cyan-500", isActive);
        button?.classList.toggle("dark:text-cyan-500", isActive);
    }

    function openMegaMenu() {
        megaMenu?.classList.remove("hidden");
        button?.setAttribute("aria-expanded", "true");

        setActiveState(true); // ✅ add active color

        const firstLink = getFocusableElements()?.[0];
        firstLink && (firstLink as HTMLElement).focus();
    }

    function closeMegaMenu() {
        megaMenu?.classList.add("hidden");
        button?.setAttribute("aria-expanded", "false");

        setActiveState(false); // ✅ remove active color
    }

    function toggleMegaMenu() {
        const isOpen = button?.getAttribute("aria-expanded") === "true";
        isOpen ? closeMegaMenu() : openMegaMenu();
    }

    // Click toggle
    button?.addEventListener("click", toggleMegaMenu);

    // Keyboard support
    button?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            toggleMegaMenu();
        }
    });

    // Escape close
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            closeMegaMenu();
            button?.focus();
        }
    });

    // Click outside to close
    document.addEventListener("click", (e) => {
        if (
            !megaMenu?.contains(e.target as Node) &&
            !button?.contains(e.target as Node)
        ) {
            closeMegaMenu();
        }
    });
</script>

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="BrennLabs" />
        <link rel="manifest" href="/site.webmanifest" />
        <Font cssVariable="--font-varela-round" preload />
        <meta name="generator" content={Astro.generator} />
        <title>BrennLabs</title>
    </head>

    <body class="font-body bg-linear-to-tr from-slate-50 to-cyan-50">
        <nav
            class="flex py-2 px-4 md:px-8 bg-white/90 min-h-[68px] relative z-20"
            aria-label="Main navigation"
        >
            <div
                class="max-w-6xl mx-auto flex flex-wrap items-center gap-4 w-full"
            >
                <a
                    href="#"
                    class="min-w-9 inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                >
                    <span class="sr-only">Your Company</span>
                    <Fragment set:html={brennlabsText} />
                </a>

                <div
                    id="collapseMenu"
                    tabindex="-1"
                    class="hidden z-50 outline-none lg:block max-lg:bg-white max-lg:border-l max-lg:border-slate-300 max-lg:w-1/2 max-lg:fixed max-lg:top-0 max-lg:right-0 max-lg:h-full max-lg:shadow-md max-lg:overflow-auto max-sm:w-full"
                >
                    <div
                        class="py-2 px-4 flex justify-between items-center border-b border-slate-300 sticky top-0 bg-white lg:hidden max-lg:min-h-[68px]"
                    >
                        <a
                            href="#"
                            class="inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >
                            <span class="sr-only">Your Company</span>
                            <Fragment set:html={brennlabsLogo} />
                        </a>
                        <button
                            type="button"
                            aria-controls="collapseMenu"
                            id="toggleClose"
                            class="cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >
                            <span class="sr-only">Close main menu</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="size-4 fill-slate-900"
                                aria-hidden="true"
                                viewBox="0 0 329.269 329"
                            >
                                <path
                                    d="M194.8 164.77 323.013 36.555c8.343-8.34 8.343-21.825 0-30.164-8.34-8.34-21.825-8.34-30.164 0L164.633 134.605 36.422 6.391c-8.344-8.34-21.824-8.34-30.164 0-8.344 8.34-8.344 21.824 0 30.164l128.21 128.215L6.259 292.984c-8.344 8.34-8.344 21.825 0 30.164a21.27 21.27 0 0 0 15.082 6.25c5.46 0 10.922-2.09 15.082-6.25l128.21-128.214 128.216 128.214a21.27 21.27 0 0 0 15.082 6.25c5.46 0 10.922-2.09 15.082-6.25 8.343-8.34 8.343-21.824 0-30.164zm0 0"
                                    data-original="#000000"></path>
                            </svg>
                        </button>
                    </div>

                    <ul
                        class="flex flex-col gap-8 font-semibold text-sm text-slate-900 lg:flex-row max-lg:p-6 lg:ml-12"
                    >
                        <li>
                            <a
                                href="#"
                                class="hover:text-cyan-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                                >What we do</a
                            >
                        </li>

                        <li>
                            <a
                                href="#"
                                class="hover:text-cyan-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                                >Featured Products</a
                            >
                        </li>
                    </ul>
                </div>

                <div class="flex items-center gap-4 ml-auto">
                    <a
                        href="#"
                        class="py-2 px-3.5 text-sm rounded-md font-semibold text-white border border-cyan-100 bg-cyan-500 hover:bg-cyan-600 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500"
                        >Contact Us</a
                    >

                    <button
                        type="button"
                        aria-controls="collapseMenu"
                        aria-expanded="false"
                        aria-haspopup="true"
                        id="toggleOpen"
                        class="cursor-pointer lg:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                    >
                        <span class="sr-only">Open main menu</span>
                        <svg
                            class="size-7 fill-slate-900"
                            aria-hidden="true"
                            viewBox="0 0 20 20"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- <div
            role="region"
            aria-label="Promotion"
            class="bg-slate-900 px-4 py-2.5 relative flex items-center justify-center text-center border-b border-slate-800 md:px-6"
        >
            <p class="text-sm text-slate-50 font-medium pr-6 leading-relaxed">
                THIS IS A PREVIEW - WEBSITE IS STILL UNDER CONSTRUCTION
            </p>
        </div> -->

        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
    #mega-menu {
        background-color: #0e233c;
    }
    nav::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 7px; /* 4px line + 4px gap + 4px line */
        background: linear-gradient(to bottom, #05b6d4 0 4px, #cfd0d2 4px 7px);
    }
</style>
