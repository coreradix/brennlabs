---
import "../styles/global.css";
import brennlabsText from "../assets/brennlabs_text.svg?raw";
import brennlabsLogo from "../assets/brennlabs.svg?raw";
import { Font } from "astro:assets";
import shopeeIcon from "../assets/icons/shopee.svg";
import lazadaIcon from "../assets/icons/lazada.svg";
import tiktokIcon from "../assets/icons/tiktok.svg";
---

<script>
    const toggleOpen = document.getElementById("toggleOpen");
    const toggleClose = document.getElementById("toggleClose");
    const menu = document.getElementById("collapseMenu");

    let lastFocusedElement: HTMLElement | null = null;

    function openMenu() {
        lastFocusedElement = document.activeElement as HTMLElement;
        menu?.classList.remove("hidden");
        toggleOpen?.setAttribute("aria-expanded", "true");

        // Move focus into menu
        menu?.focus();
    }

    function closeMenu() {
        menu?.classList.add("hidden");
        toggleOpen?.setAttribute("aria-expanded", "false");

        // Restore focus without scrolling
        lastFocusedElement?.focus({ preventScroll: true });
    }

    toggleOpen?.addEventListener("click", openMenu);
    toggleClose?.addEventListener("click", closeMenu);

    // Close mobile menu when a nav link is clicked
    menu?.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (
            target.tagName === "A" &&
            target.getAttribute("href")?.startsWith("#")
        ) {
            closeMenu();
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu?.classList.contains("hidden")) {
            closeMenu();
        }
    });

    // Active section highlighting for desktop navigation links
    const navLinks = document.querySelectorAll(
        'nav a[href^="#"]:not(.no-active-highlight)',
    );
    const sections = Array.from(navLinks)
        .map((link) => document.querySelector(link.getAttribute("href")!))
        .filter((section): section is Element => section !== null);

    const observerOptions = {
        root: null,
        rootMargin: "-20% 0px -60% 0px", // Trigger when section is in middle of viewport
        threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                if (id) {
                    // Update URL hash without adding to history
                    history.replaceState(null, "", `#${id}`);

                    navLinks.forEach((link) => {
                        const href = link.getAttribute("href");
                        if (href === `#${id}`) {
                            link.classList.add(
                                "text-cyan-500",
                                "font-semibold",
                            );
                            link.classList.remove("text-slate-900");
                        } else {
                            link.classList.remove(
                                "text-cyan-500",
                                "font-semibold",
                            );
                            link.classList.add("text-slate-900");
                        }
                    });
                }
            }
        });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));

    // Mega menu logic
    const button = document.getElementById("mega-menu-button");
    const megaMenu = document.getElementById("mega-menu");

    const focusableSelectors =
        "a[href], button:not([disabled]), [tabindex='0']";

    const getFocusableElements = () =>
        megaMenu?.querySelectorAll(focusableSelectors);

    // 👉 helper for active state
    function setActiveState(isActive: boolean) {
        button?.classList.toggle("text-cyan-500", isActive);
        button?.classList.toggle("dark:text-cyan-500", isActive);
    }

    function openMegaMenu() {
        megaMenu?.classList.remove("hidden");
        button?.setAttribute("aria-expanded", "true");

        setActiveState(true); // ✅ add active color

        const firstLink = getFocusableElements()?.[0];
        firstLink && (firstLink as HTMLElement).focus();
    }

    function closeMegaMenu() {
        megaMenu?.classList.add("hidden");
        button?.setAttribute("aria-expanded", "false");

        setActiveState(false); // ✅ remove active color
    }

    function toggleMegaMenu() {
        const isOpen = button?.getAttribute("aria-expanded") === "true";
        isOpen ? closeMegaMenu() : openMegaMenu();
    }

    // Click toggle
    button?.addEventListener("click", toggleMegaMenu);

    // Keyboard support
    button?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            toggleMegaMenu();
        }
    });

    // Escape close
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            closeMegaMenu();
            button?.focus();
        }
    });

    // Click outside to close
    document.addEventListener("click", (e) => {
        if (
            !megaMenu?.contains(e.target as Node) &&
            !button?.contains(e.target as Node)
        ) {
            closeMegaMenu();
        }
    });
</script>

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="BrennLabs" />
        <link rel="manifest" href="/site.webmanifest" />
        <Font cssVariable="--font-varela-round" preload />
        <meta name="generator" content={Astro.generator} />
        <title>BrennLabs</title>
    </head>

    <body class="font-body bg-linear-to-tr from-slate-50 to-cyan-50">
        <nav
            class="flex py-2 px-4 md:px-8 bg-white/95 min-h-[68px] sticky top-0 z-50 backdrop-blur-sm"
            aria-label="Main navigation"
        >
            <div
                class="max-w-6xl mx-auto flex flex-wrap items-center gap-4 w-full"
            >
                <a
                    href="/"
                    class="min-w-9 inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                >
                    <span class="sr-only">BrennLabs</span>
                    <Fragment set:html={brennlabsText} />
                </a>

                <!-- Desktop Navigation Links -->
                <div
                    class="hidden lg:flex lg:items-center lg:gap-8 lg:ml-12 flex-1"
                >
                    <a
                        href="#home"
                        class="hover:text-cyan-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >What we do</a
                    >
                    <a
                        href="#featured-products"
                        class="hover:text-cyan-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >Featured Products</a
                    >
                    <a
                        href="#why-choose-us"
                        class="hover:text-cyan-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >Why Choose Us</a
                    >
                </div>

                <div class="flex items-center gap-4 ml-auto lg:block">
                    <a
                        href="#contact-us"
                        class="hidden lg:inline-flex py-2 px-3.5 text-sm rounded-md font-semibold text-white border border-cyan-100 bg-cyan-500 hover:bg-cyan-600 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 no-active-highlight"
                        >Contact Us</a
                    >

                    <button
                        type="button"
                        aria-controls="collapseMenu"
                        aria-expanded="false"
                        aria-haspopup="true"
                        id="toggleOpen"
                        class="cursor-pointer lg:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded p-2"
                    >
                        <span class="sr-only">Open main menu</span>
                        <svg
                            class="size-7 fill-slate-900"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Mobile Menu -->
        <div
            id="collapseMenu"
            tabindex="-1"
            class="hidden z-50 max-lg:z-60 outline-none max-lg:bg-white max-lg:border-l max-lg:border-slate-300 max-lg:w-1/2 max-lg:fixed max-lg:top-0 max-lg:right-0 max-lg:h-full max-lg:shadow-md max-lg:overflow-auto max-sm:w-full"
        >
            <div
                class="py-2 px-4 flex justify-between items-center border-b border-slate-300 sticky top-0 bg-white lg:hidden max-lg:min-h-[68px]"
            >
                <a
                    href="/"
                    class="inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                >
                    <span class="sr-only">BrennLabs</span>
                    <Fragment set:html={brennlabsLogo} />
                </a>
                <button
                    type="button"
                    aria-controls="collapseMenu"
                    id="toggleClose"
                    class="cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded p-2"
                >
                    <span class="sr-only">Close main menu</span>
                    <svg
                        class="size-7 fill-slate-900"
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M18.3 5.71a1 1 0 00-1.41 0L12 10.59 7.11 5.7a1 1 0 00-1.41 1.41L10.59 12 5.7 16.89a1 1 0 001.41 1.41L12 13.41l4.89 4.89a1 1 0 001.41-1.41L13.41 12l4.89-4.89a1 1 0 000-1.41z"
                            clip-rule="evenodd"></path>
                    </svg>
                </button>
            </div>

            <ul
                class="flex flex-col gap-8 font-semibold text-sm text-slate-900 max-lg:p-6"
            >
                <li>
                    <a
                        href="#home"
                        class="block w-full py-3 px-4 hover:text-cyan-500 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >What we do</a
                    >
                </li>

                <li>
                    <a
                        href="#featured-products"
                        class="block w-full py-3 px-4 hover:text-cyan-500 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >Featured Products</a
                    >
                </li>

                <li>
                    <a
                        href="#why-choose-us"
                        class="block w-full py-3 px-4 hover:text-cyan-500 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                        >Why Choose Us</a
                    >
                </li>

                <li class="lg:hidden">
                    <a
                        href="#contact-us"
                        class="inline-flex py-2 px-3.5 text-sm rounded-md font-semibold text-white border border-cyan-100 bg-cyan-500 hover:bg-cyan-600 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 w-full text-center justify-center"
                        >Contact Us</a
                    >
                </li>
            </ul>
        </div>

        <!-- <div
            role="region"
            aria-label="Promotion"
            class="bg-slate-900 px-4 py-2.5 relative flex items-center justify-center text-center border-b border-slate-800 md:px-6"
        >
            <p class="text-sm text-slate-50 font-medium pr-6 leading-relaxed">
                THIS IS A PREVIEW - WEBSITE IS STILL UNDER CONSTRUCTION
            </p>
        </div> -->

        <slot />

        <footer
            id="_footer_simple_centered_v1_001"
            class="py-12 bg-gray-50/80 border-t border-slate-200"
        >
            <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-8">
                <div class="text-center">
                    <div
                        data-motion="logo"
                        class="flex items-center justify-center gap-2 mb-6"
                        style="opacity: 1; transform: scale(1); filter: blur(0px);"
                    >
                        <a
                            href="/"
                            class="focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded"
                            aria-label="BrennLabs Home"
                        >
                            <Fragment set:html={brennlabsLogo} />
                        </a>
                    </div>

                    <div
                        data-motion="social"
                        class="flex justify-center gap-6 mb-8"
                        style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                    >
                        <a
                            data-motion="button"
                            href="https://shopee.ph/shop/1857845118"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-slate-600 hover:bg-cyan-100 hover:text-cyan-600 transition-colors"
                            style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >
                            <img
                                src={shopeeIcon.src}
                                class="w-5 h-5"
                                alt="Shopee"
                            />
                        </a>
                        <a
                            data-motion="button"
                            href="https://s.lazada.com.ph/s.ZgSxSr"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-slate-600 hover:bg-cyan-100 hover:text-cyan-600 transition-colors"
                            style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >
                            <img
                                src={lazadaIcon.src}
                                class="w-5 h-5"
                                alt="Lazada"
                            />
                        </a>
                        <a
                            data-motion="button"
                            href="https://www.tiktok.com/@brennlabs"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-slate-600 hover:bg-cyan-100 hover:text-cyan-600 transition-colors"
                            style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                        >
                            <img
                                src={tiktokIcon.src}
                                class="w-5 h-5"
                                alt="TikTok"
                            />
                        </a>
                    </div>

                    <p
                        data-motion="copyright"
                        class="text-sm text-slate-500"
                        style="opacity: 1; transform: translateY(0px); filter: blur(0px);"
                    >
                        © 2026 BrennLabs. All rights reserved.
                    </p>
                </div>
            </div>
        </footer>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
    html {
        scroll-behavior: smooth;
        scroll-padding-top: 0px;
    }
    /* Disable smooth scrolling on mobile (lg breakpoint and below) */
    @media (max-width: 1023px) {
        html {
            scroll-behavior: auto;
        }
    }
    #mega-menu {
        background-color: #0e233c;
    }
    nav::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 7px; /* 4px line + 4px gap + 4px line */
        background: linear-gradient(to bottom, #05b6d4 0 4px, #cfd0d2 4px 7px);
    }
</style>
